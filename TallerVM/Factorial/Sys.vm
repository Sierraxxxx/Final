// =====================================================================
// Sys.vm  -  Ejercicio 1 (Factorial)
// El bootstrap del traductor hace SP = 256 y luego "call Sys.init 0".
// Sys.init solo arranca el programa (Main.main) y luego se queda en un
// ciclo infinito, que es la forma de "terminar" en la plataforma Hack.
// =====================================================================

function Sys.init 0
    call Main.main 0        // ejecuta todo el programa
    pop temp 0              // descarta el 0 que devuelve Main.main (void)
label HALT
    goto HALT               // fin: ciclo infinito
